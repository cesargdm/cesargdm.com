---
import { isLocale } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'
import { getNfts } from '@/lib/open-sea'

import Layout from '@/layouts/Layout.astro'
import {
	nftDescription,
	nftImageWrapper,
	nftItem,
	nftLink,
	nftName,
	nftsList,
	nftTextWrapper,
} from '@/styles/nfts.css'

const locale = Astro.params.locale
if (!isLocale(locale)) return Astro.rewrite('/404')

const nfts = (await getNfts({ chain: 'ethereum' })).filter(
	(nft) => nft.image_url,
)

const meta = getMetadata({
	locale,
	title: 'NFTs',
	description: 'César Guadarrama Cantú - Product engineer - NFTs',
	canonicalPath: '/nfts',
})
---

<Layout locale={locale} meta={meta}>
	<h1>NFTs</h1>

	{
		/* Without this the page rendered an empty <ul> and nothing else — a blank
		   screen whenever OpenSea returned no items or was unreachable. */
		!nfts.length && (
			<p>
				Nothing to show right now. You can browse the collection on{' '}
				<a
					href="https://opensea.io/0xE3a856E4034D25FF68b3702B8f1618173BBFa130"
					target="_blank"
					rel="noopener noreferrer"
				>
					OpenSea
				</a>
				.
			</p>
		)
	}

	<ul class={nftsList}>
		{
			nfts.map((nft) => (
				<li class={nftItem}>
					<a
						href={`/${locale}/nfts/ethereum_${nft.contract}_${nft.identifier}`}
						class={nftLink}
					>
						<div class={nftImageWrapper}>
							<img
								src={nft.image_url}
								alt=""
								style={{
									width: '100%',
									height: '100%',
									objectFit: 'cover',
								}}
							/>
						</div>
						<div class={nftTextWrapper}>
							<p class={nftName}>{nft.name}</p>
							<p class={nftDescription}>{nft.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
