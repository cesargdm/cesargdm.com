---
import Bluesky from '@/modules/Bluesky/Bluesky.astro'
import Chat from '@/modules/Chat'
import GitHubContributions from '@/modules/GitHubContributions/GitHubContributions.astro'
import HoverCompany from '@/modules/HoverCompany/HoverCompany.astro'
import LastPhoto from '@/modules/LastPhoto/LastPhoto.astro'
import Nfts from '@/modules/Nfts/Nfts.astro'
import Reading from '@/modules/Reading/Reading.astro'
import Strava from '@/modules/Strava/Strava.astro'
import StravaRide from '@/modules/StravaRide/StravaRide.astro'

import { getCheerFromVisitsCount } from '@/lib/cheer'
import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'

import Layout from '@/layouts/Layout.astro'
import {
	card,
	cardsContainer,
	cardsList,
	introContainer,
	introParagraph,
	squareCard,
	twoColumnCard,
} from '@/styles/layout.css'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale
const meta = getMetadata({ locale })
---

<Layout locale={locale} meta={meta}>
	<div>
		<div class={introContainer}>
			<h1>Hi <span id="cheer">{getCheerFromVisitsCount('1')}</span>!</h1>
			<p class={introParagraph}>
				I'm a product engineer. I like owning a problem end to end — the data
				model, the API, the interface, and the thing people actually touch. Most
				of my work is TypeScript: React and React Native on the front, Node and
				Cloudflare Workers behind it. Seven years of it has mostly been fintech,
				currently at <HoverCompany name="OCHO" />, before that <HoverCompany
					name="Tesorio"
				/>, <HoverCompany name="Aura" />, <HoverCompany name="Covalto" /> and{
					' '
				}
				<HoverCompany name="IBM" />.
			</p>
			<p class={introParagraph}>
				I build my own things too. <a href={`/${locale}/projects/tolo`}>TOLO</a
				>{' '}
				is a specialty coffee company I wrote the whole platform for — point of sale,
				mobile ordering, and an MCP server that lets AI agents query the business
				directly. <a href={`/${locale}/projects/cretia`}>Cretia</a> is an ERP for
				Mexican SMEs. More in <a href={`/${locale}/projects`}>projects</a>.
			</p>
		</div>
		{
			/*
		  Widest first, single-track cards after. A wide card that cannot fit the
		  space left on a row gets pushed down, and the tracks it skipped stay
		  empty — so leading with the wide ones keeps every gap at the end of the
		  grid instead of stranding one mid-layout.
		*/
		}
		{
			/*
		  Order is load-bearing. A wide card that cannot fit the space left on a row
		  is pushed down and the tracks it skipped stay empty, so the sequence decides
		  whether gaps land mid-grid or trail at the end.
		
		  Wide cards are spaced out rather than clustered — two tracks, three singles,
		  the graph, a single, two tracks — which both varies the rhythm and, at every
		  column count from one to five, leaves the only empty tracks after the last
		  card.
		*/
		}
		<div class={cardsContainer}>
			<ul class={cardsList}>
				<li class:list={[card, twoColumnCard]} style={{ height: '100%' }}>
					<Chat client:visible locale={locale} />
				</li>
				<li class:list={[card, squareCard]}>
					<Bluesky />
				</li>
				<li class:list={[card, squareCard]}>
					<Strava locale={locale} />
				</li>
				<li class:list={[card, squareCard]}>
					<StravaRide locale={locale} />
				</li>
				<li class:list={[card, twoColumnCard]} style={{ padding: 0 }}>
					<GitHubContributions />
				</li>
				<li class:list={[card, squareCard]} style={{ padding: 0 }}>
					<LastPhoto />
				</li>
				<li class:list={[card, twoColumnCard]} style={{ padding: 0 }}>
					<Reading />
				</li>
				<li class:list={[card, squareCard]} style={{ padding: 0 }}>
					<Nfts locale={locale} />
				</li>
			</ul>
		</div>
	</div>
</Layout>

<script>
	// The greeting depends on a visit counter kept in a cookie. Reading it on the
	// server would make this page dynamic, so it is swapped in on the client.
	import { getCheerFromVisitsCount } from '@/lib/cheer'

	function applyCheer() {
		const match = document.cookie.match(/(?:^|;\s*)visits-count=([^;]*)/)
		const node = document.getElementById('cheer')

		if (node && match) node.textContent = getCheerFromVisitsCount(match[1])
	}

	// Module scripts run once per document. With ClientRouter, returning to this
	// page is a swap rather than a load, so hook the navigation event too.
	applyCheer()
	document.addEventListener('astro:page-load', applyCheer)
</script>
