---
import Chat from '@/modules/Chat'

import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'

import Layout from '@/layouts/Layout.astro'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale

const meta = getMetadata({
	locale,
	title: 'AI Chat',
	description:
		'Ask an AI assistant about César Guadarrama — his work, projects and background.',
	canonicalPath: '/chat',
})
---

<Layout locale={locale} meta={meta}>
	<h1>AI Chat</h1>
	<p>
		Ask about my work, projects or background. Answers come from a model running
		on Cloudflare Workers AI, grounded in what this site says about me.
	</p>
	<div style={{ minHeight: '60vh', display: 'flex', flexDirection: 'column' }}>
		<Chat client:load locale={locale} />
	</div>
</Layout>
