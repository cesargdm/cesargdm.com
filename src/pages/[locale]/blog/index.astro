---
import Layout from '@/layouts/Layout.astro'

import { getPosts } from '@/lib/blog'
import { getHumanReadableDate } from '@/lib/date'
import { isLocale } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'

import {
	entriesList,
	entryDate,
	entryItem,
	entryLink,
	entryTitle,
	pageDescription,
} from '@/styles/blog.css'

const locale = Astro.params.locale
if (!isLocale(locale)) return Astro.rewrite('/404')

const WORDS_PER_MINUTE = 200

function getReadingTime(content: string) {
	const words = content.split(/\s/g).length
	return Math.ceil(words / WORDS_PER_MINUTE)
}

const entries = getPosts(locale)

const meta = getMetadata({
	locale,
	title: 'Blog',
	description:
		'Read about coding tips, tutorials, programming configurations, thoughts, ideas and more',
	canonicalPath: '/blog',
})
---

<Layout locale={locale} meta={meta}>
	<h1>Blog</h1>
	<p class={pageDescription}>
		Read about coding tips, tutorials, programming configurations, thoughts,
		ideas and more
	</p>
	<ul class={entriesList}>
		{
			entries.map((entry) => (
				<li class={entryItem}>
					<a class={entryLink} href={`/${locale}/blog/${entry.slug}`}>
						<p class={entryTitle}>{entry.data.title}</p>
						<p class={entryDate}>
							{getHumanReadableDate(entry.data.date as string)} •{' '}
							{getReadingTime(entry.content)} minutes read
						</p>
						<p>{entry.data.extract}</p>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
