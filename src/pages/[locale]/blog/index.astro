---
import { getPosts } from '@/lib/blog'
import { getHumanReadableDate } from '@/lib/date'
import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'
import { getTranslate } from '@/lib/translate'

import Layout from '@/layouts/Layout.astro'
import {
	entriesList,
	entryDate,
	entryItem,
	entryLink,
	entryTitle,
	pageDescription,
} from '@/styles/blog.css'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale
const t = getTranslate(locale)

const WORDS_PER_MINUTE = 200

function getReadingTime(content: string) {
	const words = content.split(/\s/g).length
	return Math.ceil(words / WORDS_PER_MINUTE)
}

const entries = getPosts(locale)

const meta = getMetadata({
	locale,
	title: t('blog.title'),
	description: t('blog.description'),
	canonicalPath: '/blog',
})
---

<Layout locale={locale} meta={meta}>
	<h1>{t('blog.title')}</h1>
	<p class={pageDescription}>{t('blog.description')}</p>
	<ul class={entriesList}>
		{
			entries.map((entry) => (
				<li class={entryItem}>
					<a class={entryLink} href={`/${locale}/blog/${entry.slug}`}>
						<p class={entryTitle}>{entry.data.title}</p>
						<p class={entryDate}>
							{getHumanReadableDate(entry.data.date as string)} •{' '}
							{t('blog.readingTime', {
								minutes: getReadingTime(entry.content),
							})}
						</p>
						<p>{entry.data.extract}</p>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
