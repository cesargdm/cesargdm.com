---
import { isLocale } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'
import social from '@/lib/social.json'
import { getTranslate } from '@/lib/translate'

import Layout from '@/layouts/Layout.astro'
import { notFoundContainer } from '@/styles/blog-post.css'

const locale = Astro.params.locale
if (!isLocale(locale)) return Astro.rewrite('/404')

const dynamic = Astro.params.dynamic ?? ''

if (dynamic in social) {
	return Astro.redirect(social[dynamic as keyof typeof social].url)
}

const t = getTranslate(locale)

Astro.response.status = 404

const meta = getMetadata({ locale, title: t('notFound.title') })
---

<Layout locale={locale} meta={meta}>
	<div class={notFoundContainer}>
		<h1>🙈 {t('notFound.title')}</h1>
		<p>
			{t('notFound.description')}
			<a href={`/${locale}`}>{t('notFound.home')}</a>
		</p>
	</div>
</Layout>
