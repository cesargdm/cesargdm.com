---
import { IconBrandGithub, IconStar } from '@tabler/icons-react'

import { getHumanReadableDate } from '@/lib/date'
import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'
import { getProjects } from '@/lib/projects'

import Layout from '@/layouts/Layout.astro'
import {
	entriesList,
	entryDate,
	entryDescriptionContainer,
	entryItem,
	entryText,
	entryTitle,
	highlightedEntryItem,
	pageDescription,
	projectDescription,
	projectEntryLink,
	projectTechnologies,
	projectTechnologyItem,
} from '@/styles/blog.css'
import { vars } from '@/styles/theme.css'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale

const entries = getProjects(locale)

const meta = getMetadata({
	locale,
	title: 'Projects',
	description:
		'Software engineering projects, websites, web apps, native apps for iOS and Android and more',
	canonicalPath: '/projects',
})
---

<Layout locale={locale} meta={meta}>
	<h1>Projects</h1>
	<p class={pageDescription}>
		Here are some of the projects I've worked on. You can find more information
		for each one.
	</p>
	<ul class={entriesList}>
		{
			entries.map((entry) => {
				const highlight = entry.data.highlight as
					| { color?: string; logoUrl?: string }
					| undefined
				const repository = entry.data.repository as
					| { url: string; stars?: number }
					| undefined

				return (
					<li class={highlight ? highlightedEntryItem : entryItem}>
						<a
							style={{ backgroundColor: highlight?.color }}
							class={projectEntryLink}
							href={`/${locale}/projects/${entry.slug}`}
						>
							{typeof highlight === 'object' ? (
								<img
									width={100}
									height={100}
									style={{ borderRadius: '20px' }}
									src={highlight.logoUrl}
									alt=""
								/>
							) : null}
							<div class={entryText}>
								<div class={entryDescriptionContainer}>
									<h2 class={entryTitle}>{entry.data.title}</h2>
									<p class={entryDate}>
										{getHumanReadableDate(entry.data.date as string)}
									</p>
								</div>
								<p class={projectDescription}>{entry.data.description}</p>
								{Array.isArray(entry.data.tags) ? (
									<ul class={projectTechnologies}>
										{(entry.data.tags as string[]).map((tech) => (
											<li class={projectTechnologyItem}>{tech}</li>
										))}
									</ul>
								) : null}
							</div>
						</a>

						{repository ? (
							<div
								style={{
									position: 'absolute',
									bottom: 0,
									right: 0,
									padding: '16px',
								}}
							>
								<a
									style={{
										display: 'flex',
										alignItems: 'center',
										gap: '2px',
										backgroundColor: repository.stars
											? 'gold'
											: vars.colors.background.gray,
										padding: '4px 8px',
										borderRadius: '16px',
										color: '#333',
										textDecoration: 'none',
									}}
									href={repository.url}
								>
									{repository.stars ? (
										<span style={{ fontSize: '0.7rem' }}>
											{repository.stars}
										</span>
									) : null}
									{repository.stars ? (
										<IconStar size={12} />
									) : (
										<IconBrandGithub size={12} />
									)}
								</a>
							</div>
						) : null}
					</li>
				)
			})
		}
	</ul>
</Layout>
