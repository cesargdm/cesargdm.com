---
// The explicit /index, rather than the directory: Vite resolves the bare
// directory to a PhotoMosaic.tsx that does not exist, so every hot update of
// this island fails to apply and the page silently keeps running the module it
// loaded first.
import PhotoMosaic from '@/modules/PhotoMosaic/index'

import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { getMetadata } from '@/lib/metadata'
import { MOSAIC_COPY } from '@/lib/mosaic-copy'
import { TOOL_PATHS } from '@/lib/tools'

import Layout from '@/layouts/Layout.astro'
import { entryContainer } from '@/styles/project-post.css'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale

// The Spanish tool has its own slug. This path is only meant for English, but
// it stays reachable in Spanish as a redirect rather than a 404.
if (locale !== 'en') {
	return Astro.redirect(
		`/${locale}/projects/${TOOL_PATHS.photoMosaic[locale]}`,
		301,
	)
}

const copy = MOSAIC_COPY[locale]

const meta = getMetadata({
	locale,
	title: `${copy.title} - Projects`,
	description: copy.description,
	canonicalPath: `/projects/${TOOL_PATHS.photoMosaic[locale]}`,
})
---

<Layout locale={locale} meta={meta}>
	<div class={entryContainer}>
		<h1>{copy.title}</h1>
		<p>{copy.intro}</p>

		<PhotoMosaic client:only="react" copy={copy} />

		<noscript>
			<p>{copy.noscript}</p>
		</noscript>
	</div>
</Layout>
