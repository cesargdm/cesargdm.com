---
import type { Locale } from '@/lib/i18n'
import { LOCALES } from '@/lib/i18n'
import { TOOL_PATHS } from '@/lib/tools'

export const prerender = true

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale

// This URL shipped as an empty stub before the tool existed. Redirecting rather
// than deleting keeps anything already indexed pointing somewhere useful.
return Astro.redirect(
	`/${locale}/projects/${TOOL_PATHS.qrCodeGenerator[locale]}`,
	301,
)
---
