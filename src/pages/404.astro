---
import { getMetadata } from '@/lib/metadata'

import Layout from '@/layouts/Layout.astro'
import { errorPageContainer } from '@/styles/layout.css'
import { vars } from '@/styles/theme.css'

const meta = getMetadata({ locale: 'en', title: 'Not Found' })
---

<Layout locale="en" meta={meta}>
	<div class={errorPageContainer}>
		<h1>🙈 Not Found</h1>
		<img height={144} width={300} src="/images/this-is-fine.png" alt="" />
		<p>
			You just hit a page that doesn't exist... the sadness.
			<a
				style={{
					fontWeight: vars.fontWeight.bold,
					display: 'block',
					textAlign: 'center',
				}}
				href="/">Go back home</a
			>
		</p>
	</div>
</Layout>
