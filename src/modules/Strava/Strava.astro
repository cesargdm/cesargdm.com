---
import { IconBrandStrava } from '@tabler/icons-react'

import type { Locale } from '@/lib/i18n'
import { getLastRun } from '@/lib/strava'

import {
	distanceText,
	distanceUnit,
	runContainer,
	runName,
	stravaButton,
} from './styles.css'

type Props = {
	locale: Locale
}

const { locale } = Astro.props

const run = await getLastRun()

// `startDateLocal` is already the athlete's wall-clock time, so it must be
// formatted as UTC — formatting in the server's zone would shift it again.
const formattedDate = run
	? new Intl.DateTimeFormat(locale, {
			day: 'numeric',
			month: 'long',
			timeZone: 'UTC',
		}).format(new Date(run.startDateLocal))
	: ''
---

{
	run ? (
		<>
			<h2>
				<IconBrandStrava aria-hidden />
				Last run
			</h2>

			<div class={runContainer}>
				<p class={distanceText}>
					{run.distanceKm.toFixed(1)}
					<span class={distanceUnit}> km</span>
				</p>
				<p class={runName}>{run.name}</p>
				<p>
					<small>
						{formattedDate} · {Math.round(run.movingTimeMinutes)} min
					</small>
				</p>
			</div>

			<a
				target="_blank"
				rel="noopener noreferrer"
				class={stravaButton}
				href={run.url}
			>
				View on Strava
			</a>
		</>
	) : null
}
