---
import { IconBrandStrava } from '@tabler/icons-react'

import type { Locale } from '@/lib/i18n'
import { getRunTotal } from '@/lib/strava'

import {
	distanceText,
	distanceUnit,
	runContainer,
	runName,
	stravaButton,
} from './styles.css'

type Props = {
	locale: Locale
}

const { locale } = Astro.props

const total = await getRunTotal()

const COPY = {
	en: { heading: 'Run', unit: 'km', period: 'ran this year', cta: 'View more' },
	es: {
		heading: 'Correr',
		unit: 'km',
		period: 'corridos este año',
		cta: 'Ver más',
	},
} as const

const copy = COPY[locale]
---

{
	total && total.activityCount > 0 ? (
		<>
			<h2>
				<IconBrandStrava aria-hidden />
				{copy.heading}
			</h2>

			<div class={runContainer}>
				<p class={distanceText}>
					{Math.round(total.distanceKm)}
					<span class={distanceUnit}> {copy.unit}</span>
				</p>
				<p class={runName}>{copy.period}</p>
			</div>

			<a
				target="_blank"
				rel="noopener noreferrer"
				class={stravaButton}
				href={total.profileUrl}
			>
				{copy.cta}
			</a>
		</>
	) : null
}
