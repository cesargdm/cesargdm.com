---
import { IconBrandUnsplash } from '@tabler/icons-react'

import { getLastPhotos } from '@/lib/unsplash'

import { vars } from '@/styles/theme.css'

import {
	image,
	morePhotosButton,
	photoContainer,
	photosWrapper,
} from './styles.css'

const photos = await getLastPhotos()
---

<div class={photosWrapper}>
	{
		photos.map((photo) => (
			<div class={photoContainer}>
				<img
					width={photo.width}
					height={photo.height}
					loading="lazy"
					decoding="async"
					class={image}
					src={photo.url}
					alt={photo.alt}
				/>
			</div>
		))
	}
</div>
<a
	target="_blank"
	rel="noopener noreferrer"
	class={morePhotosButton}
	href="https://unsplash.com/@cesargdm"
>
	View more photos
</a>
<div
	style={{
		color: 'white',
		display: 'flex',
		position: 'absolute',
		top: vars.space.large,
		gap: vars.space.small,
		textDecoration: 'none',
		left: vars.space.large,
	}}
>
	<IconBrandUnsplash fill="white" strokeWidth={0} aria-hidden />
	<h2>Unsplash</h2>
</div>
