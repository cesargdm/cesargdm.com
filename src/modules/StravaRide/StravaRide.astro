---
import { IconBrandStrava } from '@tabler/icons-react'

import {
	distanceText,
	distanceUnit,
	runContainer,
	runName,
	stravaButton,
} from '@/modules/Strava/styles.css'

import type { Locale } from '@/lib/i18n'
import { getRideTotal } from '@/lib/strava'

type Props = {
	locale: Locale
}

const { locale } = Astro.props

const total = await getRideTotal()

const COPY = {
	en: {
		heading: 'MTB',
		unit: 'm',
		period: 'climbed this year',
		cta: 'View more',
	},
	es: {
		heading: 'MTB',
		unit: 'm',
		period: 'escalados este año',
		cta: 'Ver más',
	},
} as const

const copy = COPY[locale]
---

{
	total && total.activityCount > 0 ? (
		<>
			<h2>
				<IconBrandStrava aria-hidden />
				{copy.heading}
			</h2>

			<div class={runContainer}>
				<p class={distanceText}>
					{Math.round(total.elevationM).toLocaleString(locale)}
					<span class={distanceUnit}> {copy.unit}</span>
				</p>
				<p class={runName}>{copy.period}</p>
			</div>

			<a
				target="_blank"
				rel="noopener noreferrer"
				class={stravaButton}
				href={total.latest?.url ?? 'https://www.strava.com/athletes'}
			>
				{copy.cta}
			</a>
		</>
	) : null
}
