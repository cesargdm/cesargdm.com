---
import { IconBrandStrava } from '@tabler/icons-react'

import {
	distanceText,
	distanceUnit,
	runContainer,
	runName,
	stravaButton,
} from '@/modules/Strava/styles.css'

import type { Locale } from '@/lib/i18n'
import { getRideTotal } from '@/lib/strava'

type Props = {
	locale: Locale
}

const { locale } = Astro.props

const total = await getRideTotal()

const COPY = {
	en: { heading: 'MTB', unit: 'm climbed this year', rides: 'rides' },
	es: { heading: 'MTB', unit: 'm escalados este año', rides: 'salidas' },
} as const

const copy = COPY[locale]

const latestDate = total?.latest
	? new Intl.DateTimeFormat(locale, {
			day: 'numeric',
			month: 'long',
			timeZone: 'UTC',
		}).format(new Date(total.latest.startDateLocal))
	: ''
---

{
	total && total.activityCount > 0 ? (
		<>
			<h2>
				<IconBrandStrava aria-hidden />
				{copy.heading}
			</h2>

			<div class={runContainer}>
				<p class={distanceText}>
					{Math.round(total.elevationM).toLocaleString(locale)}
					<span class={distanceUnit}> {copy.unit}</span>
				</p>
				<p class={runName}>
					{total.activityCount} {copy.rides} · {Math.round(total.distanceKm)} km
				</p>
				{total.latest ? (
					<p>
						<small>
							{total.latest.name} · {latestDate}
						</small>
					</p>
				) : null}
			</div>

			<a
				target="_blank"
				rel="noopener noreferrer"
				class={stravaButton}
				href={total.latest?.url ?? 'https://www.strava.com/athletes'}
			>
				View on Strava
			</a>
		</>
	) : null
}
