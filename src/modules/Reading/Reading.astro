---
import { IconBook } from '@tabler/icons-react'

import { getCurrentlyReading } from '@/lib/goodreads'

import { vars } from '@/styles/theme.css'

import {
	bookAnchor,
	bookImage,
	bookItem,
	bookList,
	titleText,
} from './styles.css'

const books = await getCurrentlyReading()
---

{
	books.length ? (
		<>
			<h2 style={{ padding: vars.space.large }}>
				<IconBook aria-hidden />
				Reading
			</h2>
			<ul class={bookList}>
				{books.map((book) => (
					<li class={bookItem}>
						<a
							href={book.url}
							target="_blank"
							class={bookAnchor}
							rel="noopener noreferrer"
						>
							<img
								loading="lazy"
								decoding="async"
								class={bookImage}
								src={book.image}
								alt=""
							/>
							<div
								style={{
									textAlign: 'center',
									marginTop: '16px',
									height: '3rem',
								}}
							>
								<p class={titleText}>{book.title}</p>
								<p>{book.author}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</>
	) : null
}
