---
import { ClientRouter } from 'astro:transitions'

import Footer from '@/modules/Footer/Footer.astro'
import Nav from '@/modules/Nav/Nav.astro'
import NftModal from '@/modules/NftModal/NftModal.tsx'

import type { Locale } from '@/lib/i18n'
import type { ResolvedMetadata } from '@/lib/metadata'

import { body, content } from '@/styles/layout.css'
import { darkTheme, lightTheme, responsiveTheme } from '@/styles/theme.css'

// One variable face covers every weight the scale uses, replacing four
// static files — and the 100 and 900 weights nothing referenced.
import '@fontsource-variable/inter'

import '@/styles/global.css'

type Props = {
	locale: Locale
	meta: ResolvedMetadata
}

const { locale, meta } = Astro.props

// The theme is applied by an inline script rather than read from the cookie on
// the server: reading it here would force every page to render per-request and
// forfeit static output. The script runs before first paint, so there is no
// flash of the wrong theme.
const themeClasses = {
	dark: darkTheme,
	light: lightTheme,
	responsive: responsiveTheme,
}

/*
 * Ramps for the glass refraction, one per axis. Flat mid-grey across the middle
 * so the centre of a pane displaces by nothing, steep over the last tenth so the
 * bending concentrates at the rim the way it does in real glass.
 */
const EDGE = 0.22

function ramp(vertical: boolean) {
	const channel = vertical
		? (v: number) => `rgb(0,${v},0)`
		: (v: number) => `rgb(${v},0,0)`
	const [x2, y2] = vertical ? [0, 1] : [1, 0]

	const svg =
		`<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' preserveAspectRatio='none'>` +
		`<linearGradient id='g' x1='0' y1='0' x2='${x2}' y2='${y2}'>` +
		`<stop offset='0' stop-color='${channel(0)}'/>` +
		`<stop offset='${EDGE}' stop-color='${channel(128)}'/>` +
		`<stop offset='${1 - EDGE}' stop-color='${channel(128)}'/>` +
		`<stop offset='1' stop-color='${channel(255)}'/>` +
		`</linearGradient>` +
		`<rect width='100' height='100' fill='url(%23g)'/></svg>`

	return `data:image/svg+xml,${svg.replaceAll('<', '%3C').replaceAll('>', '%3E').replaceAll('#', '%23')}`
}

const X_MAP = ramp(false)
const Y_MAP = ramp(true)
---

<!doctype html>
<html lang={locale} class={themeClasses.responsive}>
	<head>
		<script is:inline define:vars={{ themeClasses }}>
			function applyTheme() {
				try {
					const match = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/)
					const theme = match ? decodeURIComponent(match[1]) : ''
					const next = themeClasses[theme]

					if (next) {
						document.documentElement.classList.remove(themeClasses.responsive)
						document.documentElement.classList.add(next)
					}
				} catch {
					// A blocked cookie jar just means the responsive default stays.
				}
			}

			applyTheme()

			// ClientRouter copies the incoming document's <html> attributes over the
			// live ones, which resets the class back to the responsive default.
			// Re-applying before the swap paints avoids a flash of the wrong theme.
			document.addEventListener('astro:after-swap', applyTheme)
		</script>
		<ClientRouter />
		<meta charset="utf-8" />
		<meta name="viewport" content="initial-scale=1, viewport-fit=cover" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={meta.canonical} />

		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		<meta name="keywords" content={meta.keywords.join(', ')} />
		<meta name="creator" content={meta.creator} />
		<meta name="author" content={meta.creator} />

		<meta property="og:type" content={meta.type} />
		<meta property="og:title" content={meta.title} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:url" content={meta.canonical} />
		{meta.images.map((image) => <meta property="og:image" content={image} />)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={meta.twitterUsername} />
		<meta name="twitter:creator" content={meta.twitterUsername} />
		<meta name="twitter:title" content={meta.title} />
		<meta name="twitter:description" content={meta.description} />
		{meta.images.map((image) => <meta name="twitter:image" content={image} />)}
	</head>
	<body class={body}>
		{
			/*
		  The displacement map behind the glass refraction.

		  Noise was the wrong shape for this: feTurbulence warps the whole surface
		  evenly, which reads as a wobble or a zoom rather than as glass. A real
		  pane is optically neutral through the middle and bends hardest at the
		  rim, so the map is a pair of ramps that sit flat at mid-grey across the
		  centre and climb steeply over the last fifth at each edge.

		  Scale has to stay under the height of the shortest surface using it —
		  the nav pill is about 40px tall, and displacing by more than that samples
		  far outside the pane and tears into visible spikes.

		  Red carries the horizontal displacement and green the vertical, built as
		  two images and summed. Arithmetic compositing keeps each in its own
		  channel, so the centre lands on rgb(128,128,0) and displaces by nothing.

		  It lives in the document because backdrop-filter can only reference a
		  filter by id, and it is rendered once here rather than per surface.
		*/
		}
		<svg
			width="0"
			height="0"
			aria-hidden="true"
			style={{ position: 'absolute' }}
		>
			<filter
				id="glass-refraction"
				filterUnits="objectBoundingBox"
				x="0"
				y="0"
				width="1"
				height="1"
			>
				<feImage href={X_MAP} preserveAspectRatio="none" result="xMap"
				></feImage>
				<feImage href={Y_MAP} preserveAspectRatio="none" result="yMap"
				></feImage>
				<feComposite
					in="xMap"
					in2="yMap"
					operator="arithmetic"
					k1="0"
					k2="1"
					k3="1"
					k4="0"
					result="map"></feComposite>
				<feDisplacementMap
					in="SourceGraphic"
					in2="map"
					scale="22"
					xChannelSelector="R"
					yChannelSelector="G"></feDisplacementMap>
			</filter>
		</svg>

		<Nav locale={locale} />

		<main class={content}>
			<slot />
		</main>

		<NftModal client:idle />

		<Footer locale={locale} />
	</body>
</html>
