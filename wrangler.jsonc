{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cesargdm-com",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	// Workers AI powers the /api/assistant chat endpoint. There is no local
	// simulation; `remote: true` is required (omitting it still connects remotely
	// but Wrangler warns). Needs a token with Workers AI + Workers Scripts.
	"ai": {
		"binding": "AI",
		"remote": true,
	},
	// Custom Domains, not routes: Cloudflare provisions the certificate and owns
	// the DNS records, which replaces the A records that pointed at Vercel.
	"routes": [
		{ "pattern": "cesargdm.com", "custom_domain": true },
		{ "pattern": "www.cesargdm.com", "custom_domain": true },
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
}
